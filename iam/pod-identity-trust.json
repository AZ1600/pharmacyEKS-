{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPharmacyApiPodIdentity",
      "Effect": "Allow",
      "Principal": {
        "Service": "pods.eks.amazonaws.com"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/eks-cluster-name": "pharmacy-eks",
          "aws:RequestTag/kubernetes-namespace": "default",
          "aws:RequestTag/kubernetes-service-account": "pharmacy-api"
        }
      }
    }
  ]
}
